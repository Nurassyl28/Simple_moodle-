# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=sduhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sduhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Порт на хосте для psql. 5432 часто занят локально установленным Postgres.
POSTGRES_HOST_PORT=5433

# --- Moodle ---
MOODLE_SITE=https://moodle.sdu.edu.kz

# --- Секреты ---
# Ключ шифрования токенов Moodle. Fernet-ключ, 32 байта в base64.
# Сгенерировать:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при смене ключа все сохранённые токены станут нечитаемыми — студентам
# придётся войти заново.
TOKEN_ENCRYPTION_KEY=

# Общий секрет для вызовов между сервисами внутри docker-сети.
# Сгенерировать:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- Gateway ---
GATEWAY_PORT=8000
# Порт, на котором открывается сам сервис.
WEB_PORT=5173
# Откуда фронту разрешено обращаться, через запятую.
CORS_ORIGINS=http://localhost:5173
# Для локальной разработки по http cookie не может быть secure.
COOKIE_SECURE=false

# --- Распознавание расписания с картинки ---
# Ключ Claude API. Без него функция просто выключена, остальной сервис работает.
# Взять на console.anthropic.com
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5

# --- Сессии ---
SESSION_TTL_HOURS=720
