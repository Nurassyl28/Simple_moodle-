# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=sduhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sduhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Moodle ---
MOODLE_SITE=https://moodle.sdu.edu.kz

# --- Секреты ---
# Ключ шифрования токенов Moodle. Fernet-ключ, 32 байта в base64.
# Сгенерировать:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при смене ключа все сохранённые токены станут нечитаемыми — студентам
# придётся войти заново.
TOKEN_ENCRYPTION_KEY=

# Общий секрет для вызовов между сервисами внутри docker-сети.
# Сгенерировать:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- Сессии ---
SESSION_TTL_HOURS=720
